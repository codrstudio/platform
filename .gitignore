# ============================================
# Platform Project .gitignore
# ============================================
# React 19 + Vite (Frontend)
# Express + TypeScript (Backend)
# n8n Workflows (Backbone)
# ============================================

# ============================================
# Node.js Dependencies
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================
# Build Outputs
# ============================================
# Backend (TypeScript compilation)
**/backend/dist/
**/backend/build/

# Frontend (Vite build)
**/frontend/dist/
**/frontend/dist-ssr/
**/frontend/build/

# General build dirs
dist/
build/

# ============================================
# Environment Variables
# ============================================
# CRITICAL: Never commit .env files with secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Keep example files (these SHOULD be committed)
!.env.example
!**/backend/.env.example
!**/frontend/.env.example

# ============================================
# Logs
# ============================================
logs/
*.log
**/backend/logs/
**/frontend/logs/
combined.log
error.log
exceptions.log

# ============================================
# Temporary Files (.tmp/)
# ============================================
# As per CLAUDE.md: temporary files go here
.tmp/
*.tmp
*.temp
temp/

# ============================================
# Testing & Coverage
# ============================================
coverage/
*.coverage
.nyc_output/
.jest/
test-results/
playwright-report/
playwright/.cache/

# ============================================
# Caching
# ============================================
# Vite cache
.vite/
**/frontend/.vite/

# TypeScript cache
*.tsbuildinfo

# ESLint cache
.eslintcache

# parcel-bundler cache
.cache/
.parcel-cache/

# ============================================
# Redis
# ============================================
dump.rdb
*.rdb
redis-data/

# ============================================
# IDEs & Editors
# ============================================
# VSCode
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ, etc)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ============================================
# Operating System
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*
.directory
.Trash-*

# ============================================
# Package Manager Lock Files
# ============================================
# Keep lock files for consistency
# If using npm, keep package-lock.json
# If using yarn, keep yarn.lock
# If using pnpm, keep pnpm-lock.yaml

# Uncomment below if you want to ignore lock files (not recommended)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================
# Miscellaneous
# ============================================
# Debug files
*.pid
*.seed
*.pid.lock

# Runtime data
pids/

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov/

# Compiled binary addons
build/Release/

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Next.js (if added later)
.next/
out/

# Nuxt.js (if added later)
.nuxt/

# Storybook (if added later)
storybook-static/

# ============================================
# Documentation (AUTO-GENERATED)
# ============================================
# Keep documentation sources, ignore auto-generated docs
# docs/api/generated/
# typedoc/

# ============================================
# Project-Specific
# ============================================
# Validation/completion reports that are temporary
# Keep committed reports, ignore local test runs
*-LOCAL.md
*-TEST.md

# Backup files
*.bak
*.backup
*.old

# ============================================
# Security
# ============================================
# Never commit private keys, certificates, or secrets
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
secrets/
.secrets/

.worktrees/
use-cases/
