# ============================================
# NIC CHAT - Configuração Backend
# ============================================
# Este arquivo documenta as variáveis de ambiente necessárias.
# Copie para .env e ajuste conforme necessário.

# ============================================
# SERVIDOR
# ============================================
PORT=7007

# ============================================
# N8N CONFIGURATION (server-side)
# ============================================
# URL base do N8N para descoberta de agentes
N8N_BASE_URL=https://n8n.codrstudio.dev/webhook/nic/v1

# ============================================
# API KEYS DOS PROVEDORES DE IA (server-side apenas)
# ============================================
# Chaves de autenticação injetadas pelo backend (NUNCA expostas ao frontend)

# NIC - Provedor interno
# Obtenha sua chave em: https://n8n.codrstudio.dev
NIC_API_KEY=

# OpenAI
# Obtenha sua chave em: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ============================================
# AGENTES BUILT-IN (frontend config via VITE_)
# ============================================
# Agentes configurados em build-time e distribuídos com a aplicação.
# Formato: VITE_AGENT_{NAME}_{PROPERTY}
# NAME deve ser UPPER_SNAKE_CASE (ex: NIC, RECRUITMENT)

# Agente NIC (padrão)
VITE_AGENT_NIC_ENABLED=true
VITE_AGENT_NIC_TITLE=NIC
VITE_AGENT_NIC_DESCRIPTION=Assistente geral da Processa Sistemas
VITE_AGENT_NIC_SYSTEM_PROMPT=Você é NIC (Núcleo de Inteligência e Conhecimento), um assistente inteligente e prestativo. Forneça respostas claras, objetivas e úteis.
VITE_AGENT_NIC_ENDPOINT=
VITE_AGENT_NIC_ICON=🤖
VITE_AGENT_NIC_COLOR=#3D95DF
VITE_AGENT_NIC_TAGS=geral,assistente

# Agente de Recrutamento (exemplo de agente especializado)
VITE_AGENT_RECRUITMENT_ENABLED=false
VITE_AGENT_RECRUITMENT_TITLE=Especialista em Recrutamento
VITE_AGENT_RECRUITMENT_DESCRIPTION=Auxilia em processos seletivos e análise de candidatos
VITE_AGENT_RECRUITMENT_SYSTEM_PROMPT=Você é um especialista em recrutamento e seleção. Ajude a avaliar candidatos, criar descrições de vagas e conduzir entrevistas de forma profissional e empática.
VITE_AGENT_RECRUITMENT_ENDPOINT=
VITE_AGENT_RECRUITMENT_ICON=👔
VITE_AGENT_RECRUITMENT_TAGS=recrutamento,rh,vagas

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. API keys ficam APENAS no servidor (sem prefixo VITE_)
# 2. Backend injeta as keys nas requisições para os provedores
# 3. Frontend NÃO tem acesso às API keys (segurança)
# 4. Configuração de provedores e modelos: public/config/ai-providers.json
# 5. Agentes built-in: configurados via VITE_AGENT_* (build-time)
# 6. Agentes N8N: descobertos via API /api/agents/n8n (runtime)
# 7. Agentes custom: criados pelo usuário via UI (localStorage)
# 8. NUNCA commite o arquivo .env com chaves reais
