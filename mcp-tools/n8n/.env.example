# n8n API Configuration Example
# Copy this file to .env and fill in your actual values

# Base URL for your n8n instance
N8N_BASE_URL=https://n8n.codrstudio.dev

# API Key authentication
# Generate an API key from n8n settings > API
N8N_API_KEY=your-api-key-here

# Authentication Method: 'header' or 'cookie'
# - header: Uses X-N8N-API-KEY header (default)
# - cookie: Uses n8n-api-key cookie
AUTH_METHOD=header