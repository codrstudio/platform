# Postman API Configuration Example
# Copy this file to .env and fill in your actual values

# Base URL for Postman API
POSTMAN_SERVER=https://api.getpostman.com

# API Key authentication
# Generate an API key from Postman Settings > API Keys
# https://web.postman.co/settings/me/api-keys
POSTMAN_API_KEY=your-api-key-here
