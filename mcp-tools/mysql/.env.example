# MySQL MCP Server Configuration
# Copy this file to .env and configure your settings

# ============================================
# MODE 1: DIRECT CONNECTION (Local/Accessible Database)
# ============================================
# Use this mode when MySQL is running locally or on an accessible network.
# Simply omit or leave SSH_HOST and SSH_USER empty to enable direct connection mode.

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-database

# Multi-tenancy Configuration
DEFAULT_TENANT_ID=1
VALIDATE_TENANT_ID=true

# ============================================
# MODE 2: SSH TUNNEL (Remote Database)
# ============================================
# Use this mode when MySQL is behind SSH (e.g., Hostinger, VPS).
# The server will automatically detect SSH tunnel mode when SSH_HOST and SSH_USER are set.

# SSH Tunnel Configuration (optional - leave empty for direct connection)
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=

# ============================================
# NOTES
# ============================================
# - If SSH_HOST and SSH_USER are set: SSH tunnel mode is activated
# - If SSH_HOST and SSH_USER are empty: Direct connection mode is used
# - VALIDATE_TENANT_ID=true enables warnings for queries missing tenant_id filters
# - DEFAULT_TENANT_ID is used when tenantId is not provided in query
