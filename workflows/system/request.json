      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        0
      ],
      "id": "7c0bd75c-db69-4345-bf2e-075622b1ecfd",
      "name": "schema"
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    \"name\": \"entity\",\n    \"schema\": \"platform\",\n    \"properties\": {\n      \"name\": {\n        \"type\": \"string\",\n        \"description\": \"Nome único da entidade no schema\"\n      },\n      \"schema\": {\n        \"type\": \"string\",\n        \"description\": \"Schema ao qual a entidade pertence\"\n      },\n      \"properties\": {\n        \"type\": \"object\",\n        \"description\": \"Definição dos campos da entidade (JSON Schema standard)\"\n      },\n      \"required\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"type\": \"string\"\n        },\n        \"description\": \"Lista de campos obrigatórios\"\n      }\n    },\n    \"required\": [\"name\", \"schema\", \"properties\"]\n  },\n  {\n    \"name\": \"action\",\n    \"schema\": \"platform\",\n    \"properties\": {\n      \"name\": {\n        \"type\": \"string\",\n        \"description\": \"Nome único da action (formato: operation.entity[.action])\"\n      },\n      \"schema\": {\n        \"type\": \"string\",\n        \"description\": \"Schema ao qual a action pertence\"\n      },\n      \"operation\": {\n        \"type\": \"string\",\n        \"enum\": [\"select\", \"mutate\"],\n        \"description\": \"Tipo de operação\"\n      },\n      \"entity\": {\n        \"type\": \"string\",\n        \"description\": \"Nome da entidade alvo\"\n      },\n      \"action\": {\n        \"type\": \"string\",\n        \"description\": \"Ação específica para mutate (ex: insert, update, delete)\"\n      },\n      \"supports\": {\n        \"type\": \"object\",\n        \"description\": \"Capacidades JQEL suportadas\",\n        \"properties\": {\n          \"limit\": {\n            \"type\": \"boolean\",\n            \"description\": \"Suporte a limitação de registros\"\n          },\n          \"orderBy\": {\n            \"oneOf\": [\n              { \"type\": \"boolean\" },\n              { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n            ],\n            \"description\": \"Suporte a ordenação (true = todos os campos, array = campos específicos)\"\n          },\n          \"output\": {\n            \"oneOf\": [\n              { \"type\": \"boolean\" },\n              { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n            ],\n            \"description\": \"Suporte a projeção de inclusão\"\n          },\n          \"except\": {\n            \"oneOf\": [\n              { \"type\": \"boolean\" },\n              { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n            ],\n            \"description\": \"Suporte a projeção de exclusão\"\n          },\n          \"values\": {\n            \"oneOf\": [\n              { \"type\": \"boolean\" },\n              { \"type\": \"array\", \"items\": { \"type\": \"string\" } }\n            ],\n            \"description\": \"Campos que podem ser modificados (mutate)\"\n          }\n        }\n      },\n      \"returns\": {\n        \"type\": \"object\",\n        \"description\": \"Tipo de retorno da action\",\n        \"properties\": {\n          \"type\": {\n            \"type\": \"string\",\n            \"enum\": [\"array\", \"object\"],\n            \"description\": \"Tipo base do retorno\"\n          },\n          \"items\": {\n            \"type\": \"object\",\n            \"description\": \"Definição dos itens do array\",\n            \"properties\": {\n              \"ref\": {\n                \"type\": \"string\",\n                \"description\": \"Referência à entidade (formato: entity ou schema:entity)\"\n              }\n            }\n          },\n          \"properties\": {\n            \"type\": \"object\",\n            \"description\": \"Propriedades do objeto retornado (quando não é referência)\"\n          }\n        }\n      }\n    },\n    \"required\": [\"name\", \"schema\", \"operation\", \"entity\", \"returns\"]\n  },\n  {\n    \"name\": \"role\",\n    \"schema\": \"cia\",\n    \"properties\": {\n      \"id\": {\n        \"type\": \"integer\",\n        \"description\": \"Identificador único da função\"\n      },\n      \"role\": {\n        \"type\": \"string\",\n        \"description\": \"Nome legível da função\"\n      }\n    },\n    \"required\": [\"id\", \"role\"]\n  },\n  {\n    \"name\": \"permission\",\n    \"schema\": \"cia\",\n    \"properties\": {\n      \"role_id\": {\n        \"type\": \"integer\",\n        \"description\": \"Identificador que referencia o id da função\"\n      },\n      \"permission\": {\n        \"type\": \"string\",\n        \"description\": \"Permissão concedida; pode ser '*' para acesso total\"\n      }\n    },\n    \"required\": [\"role_id\", \"permission\"]\n  }\n];"
      },
