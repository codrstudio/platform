    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n    TABLE_NAME as name,\n    'cia' as `schema`,\n    (\n        SELECT JSON_OBJECTAGG(\n            COLUMN_NAME,\n            JSON_OBJECT(\n                'type', \n                CASE \n                    WHEN DATA_TYPE IN ('int', 'bigint', 'tinyint', 'smallint', 'mediumint') THEN 'integer'\n                    WHEN DATA_TYPE IN ('varchar', 'text', 'char', 'mediumtext', 'longtext') THEN 'string'\n                    WHEN DATA_TYPE IN ('decimal', 'float', 'double') THEN 'number'\n                    WHEN DATA_TYPE IN ('datetime', 'timestamp', 'date', 'time') THEN 'string'\n                    ELSE 'string'\n                END\n            )\n        )\n        FROM INFORMATION_SCHEMA.COLUMNS c\n        WHERE c.TABLE_SCHEMA = t.TABLE_SCHEMA\n        AND c.TABLE_NAME = t.TABLE_NAME\n    ) as properties,\n    (\n        SELECT JSON_ARRAYAGG(COLUMN_NAME)\n        FROM INFORMATION_SCHEMA.COLUMNS c\n        WHERE c.TABLE_SCHEMA = t.TABLE_SCHEMA\n        AND c.TABLE_NAME = t.TABLE_NAME\n        AND c.IS_NULLABLE = 'NO'\n        AND c.COLUMN_KEY != 'PRI'\n        AND c.EXTRA NOT LIKE '%auto_increment%'\n    ) as `required`\nFROM \n    INFORMATION_SCHEMA.TABLES t\nWHERE \n    t.TABLE_SCHEMA = DATABASE()\n    AND t.TABLE_TYPE = 'BASE TABLE'\nORDER BY \n    t.TABLE_NAME;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
