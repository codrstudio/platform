      ],
      "id": "4b96fe4e-f1b0-454e-b86c-b01212e52bd5",
      "name": "standardize"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data;\nconst output = $('jqel').first().json.query.output;\n\nif (!output) {\n  return { data };\n}\n\n// Função para filtrar campos de um objeto\nfunction filterFields(obj, fields) {\n  if (!fields || fields.length === 0) {\n    return obj; // Se não há campos especificados, retorna o objeto completo\n  }\n  \n  const filtered = {};\n  fields.forEach(field => {\n    if (field in obj) {\n      filtered[field] = obj[field];\n    }\n  });\n  return filtered;\n}\n\n// Aplica o filtro de campos se output estiver definido\nlet filteredData = data;\n\nif (output && Array.isArray(output) && output.length > 0) {\n  filteredData = data.map(item => filterFields(item, output));\n}\n\nreturn { data: filteredData };"
      },
