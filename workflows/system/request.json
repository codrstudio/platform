    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        496,
        224
      ],
      "id": "43aa573d-a2b7-4798-9c32-d66fda6968b8",
      "name": "combine entities",
      "executeOnce": false
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data;\nconst eq = $('jqel').first().json.query?.where?.name?.eq;\nconst like = $('jqel').first().json.query?.where?.name?.like;\nconst schemaEq = $('jqel').first().json.query?.where?.schema?.eq;\n\n// Função para converter padrão LIKE para regex\nfunction likeToRegex(pattern) {\n  if (!pattern) return null;\n  \n  // Escapa caracteres especiais do regex, exceto * e %\n  let regexPattern = pattern.replace(/[.+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  \n  // Substitui wildcards SQL por equivalentes regex\n  // % ou * = qualquer sequência de caracteres (.*) \n  regexPattern = regexPattern.replace(/[%*]/g, '.*');\n  \n  // _ = um único caractere (.)\n  regexPattern = regexPattern.replace(/_/g, '.');\n  \n  // Ancora o padrão no início e fim\n  return new RegExp('^' + regexPattern + '$', 'i'); // 'i' para case-insensitive\n}\n\n// Filtra os dados\nlet filteredData = data;\n\n// Primeiro filtra por schema se existir\nif (schemaEq) {\n  filteredData = filteredData.filter(item => item.schema === schemaEq);\n}\n\n// Depois filtra por name (eq ou like)\nif (eq) {\n  // Filtro exato por name\n  filteredData = filteredData.filter(item => item.name === eq);\n} else if (like) {\n  // Filtro com wildcard por name usando regex\n  const regex = likeToRegex(like);\n  filteredData = filteredData.filter(item => regex.test(item.name));\n}\n\nreturn { data: filteredData || [] };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
