      ],
      "id": "37f8db9e-6169-4360-a2d8-fa7d190f8cff",
      "name": "result"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.data;\nconst { offset, limit } = $('jqel').first().json.query.options || {};\n\n// Aplica OFFSET e LIMIT\nconst startIndex = offset || 0;\nconst endIndex = limit ? startIndex + limit : data.length;\n\nconst filteredData = data.slice(startIndex, endIndex);\n\n// Retorna o array paginado\nreturn { data: filteredData || [] };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        224
      ],
      "id": "23ba5f7f-9431-4fa8-9d7c-c8908cb91cf8",
      "name": "paginate",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const data = $input.all().map(item => item.json) || [];\nreturn { data };"
      },
      "type": "n8n-nodes-base.code",
