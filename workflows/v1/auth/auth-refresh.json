    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body\n    || $input.first().json;\nconst headers = $input.first().json.headers || {};\n\nfunction getRefreshTokenFromCookie(cookieHeader) {\n  if (!cookieHeader) return null;\n  const cookies = cookieHeader.split(\";\").reduce((acc, cookie) => {\n    const [name, value] = cookie.trim().split(\"=\");\n    acc[name] = value;\n    return acc;\n  }, {});\n  return cookies[\"refresh_token\"] || null;\n}\n\nlet refresh_token = input.refresh_token || getRefreshTokenFromCookie(headers?.cookie);\n\nif (!refresh_token) {\n  return {\n    code: 401,\n    message: 'Refresh token não fornecido'\n  };\n}\n\nconst crypto = require('crypto');\nconst token_hash = crypto.createHash('sha256').update(refresh_token).digest('hex');\n\nreturn {\n  code: 200,\n  data: {\n    refresh_token,\n    token_hash\n  }\n};\n"
      },
