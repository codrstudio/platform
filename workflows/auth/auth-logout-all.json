    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body || $input.first().json;\nconst headers = $input.first().json.headers || {};\n\nfunction getAccessTokenFromCookie(cookieHeader) {\n  if (!cookieHeader) return null;\n  const cookies = cookieHeader.split(\";\").reduce((acc, cookie) => {\n    const [name, value] = cookie.trim().split(\"=\");\n    acc[name] = value;\n    return acc;\n  }, {});\n  return cookies[\"authorization\"] || cookies[\"access_token\"] || null;\n}\n\nlet access_token = input.authorization || input.access_token || headers?.authorization || getAccessTokenFromCookie(headers?.cookie);\n\nif (!access_token) {\n  return {\n    code: 401,\n    message: 'Access token não fornecido'\n  };\n}\n\nreturn {\n  code: 200,\n  data: {\n    access_token\n  }\n};"
      },
