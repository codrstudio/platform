    {
      "parameters": {
        "jsCode": "const { json } = $input.first();\n\nif (json?.code) {\n  return json;\n}\n\nif (json?.error) {\n  return {\n    code: 500,\n    message: json?.error\n  };  \n}\n\nif (typeof json?.error === \"string\") {\n  return {\n    code: 500,\n    message: json.error\n  };\n}\n\nreturn {\n  code: 500,\n  message: \"Falha interna ocorrida\"\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        208
      ],
      "id": "cc29329d-7841-4652-a3f8-ec13a2e3605d",
      "name": "Formata Erro"
    },
    {
      "parameters": {
        "jsCode": "// ==========================================\n// Extrai e Valida Credenciais\n// ==========================================\n// Valida formato e presença de username/password\n// Normaliza email (lowercase + trim)\n\nconst json = $input.first().json;\nconst { username, password } = (json.body || json);\n\n// Validação de username\nif (!username) {\n  return { code: 400, field: 'username', message: 'Usuário não informado' };\n}\n\n// Validação de formato de email\nif (!username.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)) {\n  return { code: 400, field: 'username', message: 'Email inválido' };\n}\n\n// Validação de password\nif (!password) {\n  return { code: 400, field: 'password', message: 'Senha não informada' };\n}\n\n// Retorna credenciais normalizadas\nreturn {\n  code: 200,\n  data: {\n    username: username.toLowerCase().trim(),\n    password\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
