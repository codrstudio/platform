    {
      "parameters": {
        "jsCode": "// ==========================================\n// Gera Tokens JWT\n// ==========================================\n// Cria access_token (JWT) e refresh_token\n// com rotação segura via família UUID\n  \nconst crypto = require('crypto');\n\nconst SECRET_KEY = $env[\"SECRET_KEY\"] || '73kZtS56JFkRuRpfuUj08cmOMtDzH8ZGMaKsfcZewQMqMvRIojf70toDGajiDJPm';\n\nconst payload = $input.first().json;\n\n// ==========================================\n// Funções auxiliares\n// ==========================================\n\nfunction base64urlEscape(str) {\n  return str.replace(/\\+/g, '-')\n    .replace(/\\//g, '_')\n    .replace(/=/g, '');\n}\n\nfunction generateJWT(payload, secret, expiresIn) {\n  const header = {\n    alg: 'HS256',\n    typ: 'JWT'\n  };\n  \n  payload.iat = Math.floor(Date.now() / 1000);\n  payload.exp = payload.iat + expiresIn;\n  \n  const encodedHeader = base64urlEscape(\n    Buffer.from(JSON.stringify(header)).toString('base64')\n  );\n  const encodedPayload = base64urlEscape(\n    Buffer.from(JSON.stringify(payload)).toString('base64')\n  );\n  \n  const signature = base64urlEscape(\n    crypto\n      .createHmac('sha256', secret)\n      .update(encodedHeader + '.' + encodedPayload)\n      .digest('base64')\n  );\n  \n  return encodedHeader + '.' + encodedPayload + '.' + signature;\n}\n\nfunction generateRefreshToken() {\n  return crypto.randomBytes(32).toString('hex');\n}\n\nfunction generateUUID() {\n  return crypto.randomUUID();\n}\n\n// ==========================================\n// Geração de Tokens\n// ==========================================\n\n// Access Token: JWT com 24 horas de validade\nconst access_token = generateJWT(payload, SECRET_KEY, 24 * 60 * 60);\n\n// Refresh Token: 32 bytes hex com hash SHA-256\nconst refresh_token = generateRefreshToken();\nconst refresh_token_hash = crypto.createHash('sha256').update(refresh_token).digest('hex');\n\n// Família de tokens para rotação segura\nconst familia_id = generateUUID();\n\n// Expiração do refresh_token: 7 dias\nconst expires_at = new Date();\nexpires_at.setDate(expires_at.getDate() + 7);\n\nreturn {\n  code: 200,\n  data: {\n    tokens: {\n      access_token,\n      refresh_token,\n      token_type: \"bearer\",\n    },\n    tokens_control: {\n      refresh_token_hash,\n      familia_id,\n      expires_at\n    },\n    payload\n  }\n};"
      },
