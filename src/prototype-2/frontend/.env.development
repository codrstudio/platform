# ============================================
# DEVELOPMENT ENVIRONMENT (Frontend)
# ============================================
# Local development frontend configuration.

# Backend API (must match backend PORT)
VITE_API_URL=http://localhost:3333

# Application Identity
VITE_APP_NAME=Platform App (DEV)
VITE_APP_SHORT_NAME=Platform DEV
VITE_APP_DESCRIPTION=Modular application platform (Development)

# PWA Theme
VITE_THEME_COLOR=#FF6B00
VITE_BACKGROUND_COLOR=#ffffff

# Development Features
VITE_DEV_MODE=true
VITE_ENABLE_DEBUG_TOOLS=true

# Performance Settings
VITE_API_TIMEOUT=30000
VITE_SSE_RECONNECT_INTERVAL=3000
VITE_SSE_MAX_RECONNECT_ATTEMPTS=999
