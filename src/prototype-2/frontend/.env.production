# ============================================
# PRODUCTION ENVIRONMENT (Frontend)
# ============================================
# Live production frontend configuration.

# Backend API
VITE_API_URL=https://api.example.com

# Application Identity
VITE_APP_NAME=Platform Application
VITE_APP_SHORT_NAME=Platform
VITE_APP_DESCRIPTION=Modular application platform for building scalable web applications

# PWA Theme
VITE_THEME_COLOR=#000000
VITE_BACKGROUND_COLOR=#ffffff

# Development Features (disabled)
VITE_DEV_MODE=false
VITE_ENABLE_DEBUG_TOOLS=false

# Performance Settings
VITE_API_TIMEOUT=30000
VITE_SSE_RECONNECT_INTERVAL=5000
VITE_SSE_MAX_RECONNECT_ATTEMPTS=10
