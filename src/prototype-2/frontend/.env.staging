# ============================================
# STAGING ENVIRONMENT (Frontend)
# ============================================
# Pre-production frontend configuration.

# Backend API
VITE_API_URL=https://api-staging.example.com

# Application Identity
VITE_APP_NAME=Platform App (Staging)
VITE_APP_SHORT_NAME=Platform STG
VITE_APP_DESCRIPTION=Modular application platform (Staging)

# PWA Theme
VITE_THEME_COLOR=#FFA500
VITE_BACKGROUND_COLOR=#ffffff

# Development Features (disabled in staging)
VITE_DEV_MODE=false
VITE_ENABLE_DEBUG_TOOLS=false

# Performance Settings
VITE_API_TIMEOUT=30000
VITE_SSE_RECONNECT_INTERVAL=3000
VITE_SSE_MAX_RECONNECT_ATTEMPTS=10
