# Backend API URL (proxy target in development)
VITE_API_URL=http://localhost:3000

# Application name (used in PWA manifest)
VITE_APP_NAME=Platform Application

# Development port (optional - defaults to 5173)
# VITE_PORT=5173

# PWA Manifest Configuration
VITE_APP_SHORT_NAME=Platform
VITE_APP_DESCRIPTION=Modular application platform for building scalable web applications

# Theme colors (will integrate with theme system in Sistema 1.6)
VITE_THEME_COLOR=#000000
VITE_BACKGROUND_COLOR=#ffffff
