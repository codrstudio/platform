# ============================================
# PLATFORM SETTINGS (Frontend)
# ============================================
# Frontend platform settings for infrastructure configuration.
# Changes require build/restart to apply.
#
# IMPORTANT: All frontend variables MUST have VITE_ prefix to be exposed.
# Reference: SPEC-configuration.md (SPEC-CF-FE-001:016)
#
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# --------------------------------------------
# Backend API Configuration
# --------------------------------------------
# URL of the platform backend (Express server)
VITE_API_URL=http://localhost:3000

# --------------------------------------------
# Application Identity
# --------------------------------------------
# Used in PWA manifest and page titles
VITE_APP_NAME=Platform Application
VITE_APP_SHORT_NAME=Platform
VITE_APP_DESCRIPTION=Modular application platform for building scalable web applications

# --------------------------------------------
# PWA Theme Configuration
# --------------------------------------------
# Default theme colors (can be overridden by portal settings)
VITE_THEME_COLOR=#000000
VITE_BACKGROUND_COLOR=#ffffff

# --------------------------------------------
# Development Configuration (Optional)
# --------------------------------------------
# Development server port (defaults to 5173)
# VITE_PORT=5173

# --------------------------------------------
# Feature Flags (Optional)
# --------------------------------------------
# Enable development tools and debug features
VITE_DEV_MODE=false
VITE_ENABLE_DEBUG_TOOLS=false

# --------------------------------------------
# Performance Settings (Optional)
# --------------------------------------------
# API request timeout in milliseconds
VITE_API_TIMEOUT=30000

# SSE reconnection settings
VITE_SSE_RECONNECT_INTERVAL=3000
VITE_SSE_MAX_RECONNECT_ATTEMPTS=10
