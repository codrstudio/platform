# ============================================
# PRODUCTION ENVIRONMENT
# ============================================
# Live production configuration with strict security.
# DO NOT commit this file with real secrets.
# Use environment variables or secrets manager in deployment.
#
# CRITICAL: All secrets MUST be strong, unique, and securely stored.

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com

# --------------------------------------------
# n8n Backbone Integration (HTTPS REQUIRED)
# --------------------------------------------
N8N_BASE_URL=https://n8n.example.com
N8N_SHARED_SECRET=CHANGE_ME_production_secret_min_32_chars_strong_random_alphanumeric

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_strong_redis_password_for_production
REDIS_DB=0

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
JWT_SECRET=CHANGE_ME_production_jwt_secret_min_32_chars_strong_random_alphanumeric
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# Rate Limiting (Strict)
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10               # Strict production limit
RATE_LIMIT_SKIP_SUCCESSFUL=false

# --------------------------------------------
# Brute Force Protection (Strict)
# --------------------------------------------
BRUTE_FORCE_MAX_ATTEMPTS=3               # Fewer attempts in production
BRUTE_FORCE_LOCKOUT_DURATION=900         # 15 minutes
BRUTE_FORCE_WINDOW_DURATION=600

# --------------------------------------------
# Platform Security
# --------------------------------------------
PLATFORM_SHARED_SECRET=CHANGE_ME_production_secret_min_32_chars_strong_random_alphanumeric

# --------------------------------------------
# JQEL Configuration
# --------------------------------------------
SYSTEM_SCHEMA_TARGET=n8n

# --------------------------------------------
# Logging (Minimal)
# --------------------------------------------
LOG_LEVEL=warn                            # Minimal logging in production
LOG_FORMAT=json                           # Structured logs for aggregation

# --------------------------------------------
# Optional Configuration
# --------------------------------------------
REQUEST_TIMEOUT=30000
SSE_HEARTBEAT_INTERVAL=30000
