# ============================================
# STAGING ENVIRONMENT
# ============================================
# Pre-production environment mimicking production with test data.
# Copy to .env.staging.local for personal overrides.
#
# IMPORTANT: Use HTTPS, strong secrets, production-like settings.

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=staging
PORT=3000
FRONTEND_URL=https://staging.example.com
BACKEND_URL=https://api-staging.example.com

# --------------------------------------------
# n8n Backbone Integration
# --------------------------------------------
N8N_BASE_URL=https://n8n-staging.example.com
N8N_SHARED_SECRET=CHANGE_ME_staging_secret_min_32_characters_strong_random

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
REDIS_HOST=redis-staging.example.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password_for_staging
REDIS_DB=0

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
JWT_SECRET=CHANGE_ME_staging_jwt_secret_min_32_characters_strong_random
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# Rate Limiting (Production-like)
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10               # Strict like production
RATE_LIMIT_SKIP_SUCCESSFUL=false

# --------------------------------------------
# Brute Force Protection (Production-like)
# --------------------------------------------
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_DURATION=900         # 15 minutes
BRUTE_FORCE_WINDOW_DURATION=600

# --------------------------------------------
# Platform Security
# --------------------------------------------
PLATFORM_SHARED_SECRET=CHANGE_ME_staging_secret_min_32_characters_strong_random

# --------------------------------------------
# JQEL Configuration
# --------------------------------------------
SYSTEM_SCHEMA_TARGET=n8n

# --------------------------------------------
# Logging (Moderate)
# --------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --------------------------------------------
# Optional Configuration
# --------------------------------------------
REQUEST_TIMEOUT=30000
SSE_HEARTBEAT_INTERVAL=30000
