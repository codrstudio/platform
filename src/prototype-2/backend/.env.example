# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --------------------------------------------
# n8n Backbone Integration
# --------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_SHARED_SECRET=your_shared_secret_min_32_characters_random_alphanumeric

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
JWT_SECRET=your_jwt_secret_min_32_characters_random_alphanumeric
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# Platform Security
# --------------------------------------------
# Must match N8N_SHARED_SECRET for mutual authentication
PLATFORM_SHARED_SECRET=your_shared_secret_min_32_characters_random_alphanumeric

# --------------------------------------------
# Optional Configuration (with defaults)
# --------------------------------------------
LOG_LEVEL=info
REQUEST_TIMEOUT=30000
SSE_HEARTBEAT_INTERVAL=30000
