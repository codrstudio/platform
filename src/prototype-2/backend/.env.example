# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# --------------------------------------------
# n8n Backbone Integration
# --------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_SHARED_SECRET=your_shared_secret_min_32_characters_random_alphanumeric

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
# Redis is used for:
# - Refresh token storage and rotation
# - Token family tracking (reuse detection)
# - Server-Sent Events (SSE) pub/sub
# - Session caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
JWT_SECRET=your_jwt_secret_min_32_characters_random_alphanumeric
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
# Protection against brute force and DoS attacks
# Values are environment-aware (lenient in dev, strict in prod)
RATE_LIMIT_WINDOW_MS=60000              # Time window in milliseconds (60s)
RATE_LIMIT_MAX_REQUESTS=10              # Max requests per window (production: 10, dev: 100)
RATE_LIMIT_SKIP_SUCCESSFUL=false        # Only count failed attempts

# --------------------------------------------
# Brute Force Protection
# --------------------------------------------
# Login-specific protection per username+IP combination
# Prevents password guessing attacks and credential stuffing
BRUTE_FORCE_MAX_ATTEMPTS=5              # Failed login attempts before lockout (recommended: 3-5)
BRUTE_FORCE_LOCKOUT_DURATION=900        # Lockout duration in seconds (900 = 15 minutes)
BRUTE_FORCE_WINDOW_DURATION=600         # Time window for counting attempts (600 = 10 minutes)

# --------------------------------------------
# Platform Security
# --------------------------------------------
# Must match N8N_SHARED_SECRET for mutual authentication
PLATFORM_SHARED_SECRET=your_shared_secret_min_32_characters_random_alphanumeric

# --------------------------------------------
# Optional Configuration (with defaults)
# --------------------------------------------
LOG_LEVEL=info
REQUEST_TIMEOUT=30000
SSE_HEARTBEAT_INTERVAL=30000
