# ============================================
# PLATFORM SETTINGS (.env)
# ============================================
# These settings control infrastructure and require restart to apply.
# DO NOT use for portal/module/instance config - use JQEL backend schema instead.
#
# Reference: SPEC-configuration.md (SPEC-CF-PS-001:012)
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Backend callback URL (for n8n to call back)
# Used when n8n needs to send data back to platform
BACKEND_URL=http://localhost:3000

# --------------------------------------------
# n8n Backbone Integration
# --------------------------------------------
# Base URL for n8n webhooks
N8N_BASE_URL=http://localhost:5678

# Shared secret for Backend → n8n authentication
# - Included as X-Platform-Key header in requests to n8n
# - Minimum 32 characters (alphanumeric recommended)
# - Must match PLATFORM_SHARED_SECRET in n8n's .env
N8N_SHARED_SECRET=your_shared_secret_min_32_characters_random_alphanumeric

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
# Redis is used for:
# - Refresh token storage and rotation
# - Token family tracking (reuse detection)
# - Server-Sent Events (SSE) pub/sub
# - Session caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
JWT_SECRET=your_jwt_secret_min_32_characters_random_alphanumeric
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# Rate Limiting
# --------------------------------------------
# Protection against brute force and DoS attacks
# Values are environment-aware (lenient in dev, strict in prod)
RATE_LIMIT_WINDOW_MS=60000              # Time window in milliseconds (60s)
RATE_LIMIT_MAX_REQUESTS=10              # Max requests per window (production: 10, dev: 100)
RATE_LIMIT_SKIP_SUCCESSFUL=false        # Only count failed attempts

# --------------------------------------------
# Brute Force Protection
# --------------------------------------------
# Login-specific protection per username+IP combination
# Prevents password guessing attacks and credential stuffing
BRUTE_FORCE_MAX_ATTEMPTS=5              # Failed login attempts before lockout (recommended: 3-5)
BRUTE_FORCE_LOCKOUT_DURATION=900        # Lockout duration in seconds (900 = 15 minutes)
BRUTE_FORCE_WINDOW_DURATION=600         # Time window for counting attempts (600 = 10 minutes)

# --------------------------------------------
# Platform Security
# --------------------------------------------
# Shared secret for n8n → Backend authentication
# - Validates X-Platform-Key header in incoming requests from n8n
# - MUST BE EQUAL to N8N_SHARED_SECRET (mutual authentication)
# - Minimum 32 characters (alphanumeric recommended)
PLATFORM_SHARED_SECRET=your_shared_secret_min_32_characters_random_alphanumeric

# --------------------------------------------
# JQEL Configuration
# --------------------------------------------
# Route "system" schema queries to: backend | n8n
# - backend: Process system schema queries locally (like backend schema)
# - n8n: Proxy system schema queries to n8n Backbone (default)
SYSTEM_SCHEMA_TARGET=n8n

# --------------------------------------------
# Optional Configuration (with defaults)
# --------------------------------------------
LOG_LEVEL=info
REQUEST_TIMEOUT=30000
SSE_HEARTBEAT_INTERVAL=30000

# --------------------------------------------
# Performance & Size Limits
# --------------------------------------------
MAX_REQUEST_SIZE=10mb                       # Maximum request body size (default: 10mb)

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
LOG_FORMAT=json                             # Log format: json (production) | text (development)

# --------------------------------------------
# Cache Configuration
# --------------------------------------------
# Time-To-Live for cached data (reduces backend load)
CACHE_TTL_AUTH=300                          # Authorization cache TTL in seconds (5 minutes)
CACHE_TTL_JQEL=60                           # JQEL query cache TTL in seconds (1 minute)
