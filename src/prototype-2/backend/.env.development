# ============================================
# DEVELOPMENT ENVIRONMENT
# ============================================
# Local development configuration with lenient settings.
# Copy to .env.development.local for personal overrides.

# --------------------------------------------
# Server Configuration
# --------------------------------------------
NODE_ENV=development
PORT=3333
FRONTEND_URL=http://localhost:3300
BACKEND_URL=http://localhost:3333

# --------------------------------------------
# n8n Backbone Integration
# --------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_SHARED_SECRET=dev_shared_secret_min_32_characters_for_development_only

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------------------------------------
# JWT Configuration
# --------------------------------------------
JWT_SECRET=dev_jwt_secret_min_32_characters_for_development_only_do_not_use_in_prod
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# --------------------------------------------
# Rate Limiting (Lenient in Dev)
# --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100              # High limit for development
RATE_LIMIT_SKIP_SUCCESSFUL=false

# --------------------------------------------
# Brute Force Protection (Lenient)
# --------------------------------------------
BRUTE_FORCE_MAX_ATTEMPTS=10              # More attempts in dev
BRUTE_FORCE_LOCKOUT_DURATION=300         # Shorter lockout (5 min)
BRUTE_FORCE_WINDOW_DURATION=600

# --------------------------------------------
# Platform Security
# --------------------------------------------
PLATFORM_SHARED_SECRET=dev_shared_secret_min_32_characters_for_development_only

# --------------------------------------------
# JQEL Configuration
# --------------------------------------------
SYSTEM_SCHEMA_TARGET=n8n

# --------------------------------------------
# Logging (Verbose in Dev)
# --------------------------------------------
LOG_LEVEL=debug                           # Verbose logging
LOG_FORMAT=text                           # Human-readable logs

# --------------------------------------------
# Optional Configuration
# --------------------------------------------
REQUEST_TIMEOUT=30000
SSE_HEARTBEAT_INTERVAL=30000
