# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3003
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3003

# n8n Backbone Configuration
N8N_BASE_URL=https://localhost:5678/webhook/api/1
N8N_SHARED_SECRET=your_n8n_shared_secret_min_32_chars_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_if_needed
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your_jwt_secret_min_256_bits_32_bytes_here
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Platform Security
PLATFORM_SHARED_SECRET=your_n8n_shared_secret_min_32_chars_here

# Optional: Performance
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30s
SSE_HEARTBEAT_INTERVAL=30s

# Optional: Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Optional: Cache TTL
CACHE_TTL_AUTH=5m
CACHE_TTL_JQEL=1m

# Optional: Rate Limiting
RATE_LIMIT_LOGIN=5
RATE_LIMIT_API=100

# Optional: Cache Invalidation
FORCE_CACHE_CLEAR=false
