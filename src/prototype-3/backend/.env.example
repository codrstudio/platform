# Server Configuration
PORT=3443
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3400

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# n8n Backbone Configuration
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_API_KEY=your-n8n-api-key

# n8n Mutual Authentication (SPEC-CF-AM-*, SPEC-CF-VE-006:010)
# IMPORTANT: Must be at least 32 characters, alphanumeric random string
# MUST be the same in both platform and n8n .env files
N8N_SHARED_SECRET=your-shared-secret-min-32-chars-change-this
PLATFORM_SHARED_SECRET=your-shared-secret-min-32-chars-change-this

# BullMQ Queue Configuration
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3

# Logging
LOG_LEVEL=debug
